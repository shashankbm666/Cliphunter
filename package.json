{
  "name": "cliphunt",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"uvicorn backend.app.main:app --reload --port 8000\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "uvicorn backend.app.main:app --reload --port 8000"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
